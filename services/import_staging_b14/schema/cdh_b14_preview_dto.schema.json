{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cdh_b14_preview_dto.schema.json",
  "title": "B14 strict immutable import preview DTO",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "input", "as_of", "summary", "records", "history_candidates", "dependencies", "ingress_policy", "safety"],
  "properties": {
    "schema_version": {"const": "CDH-B14-STRICT-DRYRUN-PREVIEW-DTO-1"},
    "mode": {"const": "IMMUTABLE_STRICT_DRY_RUN_PREVIEW"},
    "input": {"type": "object", "required": ["name", "format", "bytes", "sha256", "record_count", "raw_content_included", "strict_json_duplicate_gate"]},
    "as_of": {"type": "string", "pattern": "Z$"},
    "summary": {"type": "object"},
    "records": {"type": "array", "maxItems": 10000},
    "history_candidates": {"type": "array", "maxItems": 10000},
    "dependencies": {"type": "object"},
    "ingress_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duplicate_json_keys_allowed", "key_comparison", "duplicate_detection_precedes_semantic_and_provenance_validation", "error_echoes_duplicate_key_or_value"],
      "properties": {
        "duplicate_json_keys_allowed": {"const": false},
        "key_comparison": {"const": "CASE_SENSITIVE_DECODED_UNICODE"},
        "duplicate_detection_precedes_semantic_and_provenance_validation": {"const": true},
        "error_echoes_duplicate_key_or_value": {"const": false}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_write_count", "b11_write_count", "formal_history_write_count", "external_request_count", "collection_authorized", "live_source_authorized", "cta_enabled", "click_url"],
      "properties": {
        "database_write_count": {"const": 0},
        "b11_write_count": {"const": 0},
        "formal_history_write_count": {"const": 0},
        "external_request_count": {"const": 0},
        "collection_authorized": {"const": false},
        "live_source_authorized": {"const": false},
        "cta_enabled": {"const": false},
        "click_url": {"type": "null"}
      }
    }
  }
}
