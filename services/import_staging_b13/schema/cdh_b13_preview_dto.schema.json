{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cdh_b13_preview_dto.schema.json",
  "title": "B13 immutable import preview DTO",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "input", "as_of", "summary", "records", "history_candidates", "dependencies", "safety"],
  "properties": {
    "schema_version": {"const": "CDH-B13-DRYRUN-PREVIEW-DTO-1"},
    "mode": {"const": "IMMUTABLE_DRY_RUN_PREVIEW"},
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "format", "bytes", "sha256", "record_count", "raw_content_included"],
      "properties": {
        "name": {"type": "string"}, "format": {"enum": ["csv", "json"]},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 2097152},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_count": {"type": "integer", "minimum": 0, "maximum": 10000},
        "raw_content_included": {"const": false}
      }
    },
    "as_of": {"type": "string", "pattern": "Z$"},
    "summary": {"type": "object"},
    "records": {"type": "array", "maxItems": 10000},
    "history_candidates": {"type": "array", "maxItems": 10000},
    "dependencies": {"type": "object"},
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["database_write_count", "b11_write_count", "formal_history_write_count", "collection_authorized", "live_source_authorized", "cta_enabled", "click_url"],
      "properties": {
        "database_write_count": {"const": 0}, "b11_write_count": {"const": 0},
        "formal_history_write_count": {"const": 0}, "collection_authorized": {"const": false},
        "live_source_authorized": {"const": false}, "cta_enabled": {"const": false},
        "click_url": {"type": "null"}
      }
    }
  }
}
